# Foundry
out/
cache/
broadcast/

# Scratch artifacts of the `ast` profile, which exists only to generate
# exports/enums.json. Kept out of out/ and cache/ so an AST build can never displace the
# real build's artifacts, which travel in the CI cache. exports/ itself is committed: it
# is the published output, not a build product.
out-ast/
cache-ast/

# Deployments (local dev artifacts)
deployments/

# Env / secrets — NEVER commit keys or mnemonics
.env
.env.local

# Docs build
docs/

# OS / IDE
.DS_Store
.idea/
.vscode/
*.swp

# Agent scratch state — tooling memory, not protocol source
.claude/agent-memory/

# Local agent harness config — not protocol source
# No trailing slash: inside a repo checkout these are symlinks to the workspace
# copy, and a "name/" pattern matches only a real directory, never a symlink.
.axa
AXA.md
.claude
CLAUDE.md
